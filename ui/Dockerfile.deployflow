# Builds the DeployFlow web interface and serves it with nginx.
# The build steps follow the argocd-ui stage of the repository's root Dockerfile.
#
#   docker build -f ui/Dockerfile.deployflow -t deployflow-ui:0.1.0 ui

FROM docker.io/library/node:24.14.1 AS build
WORKDIR /src
COPY ["package.json", "pnpm-lock.yaml", "./"]
RUN npm install -g corepack@0.34.6 && corepack enable && pnpm install --frozen-lockfile
COPY [".", "."]
RUN pnpm exec tsc --noEmit --project ./src/app
RUN NODE_ENV='production' NODE_ONLINE_ENV='online' NODE_OPTIONS=--max_old_space_size=4096 pnpm build

FROM docker.io/library/nginx:1.27-alpine
COPY deployflow-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist/app /usr/share/nginx/html
